---
import "../styles/global.css";
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="theme-color" content="#650014" />
		<title>{title}</title>
		<link rel="icon" href="/Logos/hackthehill-logo.svg" type="image/svg+xml" />
	</head>
	<body><slot /></body>
</html>
