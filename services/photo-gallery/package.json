{
	"name": "@hack-the-hill/photo-album",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc --env=\"\" --no-autoconfig && wrangler deploy --dry-run --config wrangler.jsonc --env production --no-autoconfig",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"import:eligibility": "node tools/import-eligibility.mjs",
		"revoke:eligibility": "node tools/revoke-eligibility.mjs",
		"seed:local": "node tools/seed-local.mjs",
		"deploy:staging": "wrangler deploy --config wrangler.jsonc --env=\"\" --no-autoconfig --old-asset-ttl 86400",
		"deploy:production": "wrangler deploy --config wrangler.jsonc --env production --no-autoconfig --old-asset-ttl 86400"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.0",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"aws4fetch": "^1.0.20",
		"jose": "^6.1.0"
	},
	"overrides": {
		"@cloudflare/vitest-pool-workers": {
			"wrangler": "4.147.0",
			"miniflare": "5.20261001.0-alpha"
		},
		"sharp": "0.35.5"
	}
}
